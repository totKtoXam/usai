{
  "name": "usai",
  "version": "0.0.0",
  "description": "Deterministic CLI for reusable AI-assisted development workflows.",
  "type": "module",
  "bin": {
    "usai": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm clean && tsup ./src/cli/index.ts --format esm --platform node --target node24 --sourcemap --out-dir dist/cli",
    "clean": "node scripts/clean-dist.mjs",
    "dev": "tsx src/cli/index.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test \"tests/**/*.test.mjs\""
  },
  "keywords": [
    "ai",
    "cli",
    "markdown",
    "prompts",
    "rulesets",
    "codex",
    "claude",
    "cursor",
    "gemini",
    "agents"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@types/node": "^24.12.4",
    "prettier": "^3.5.3",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
